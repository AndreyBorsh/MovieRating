# ── WAW self-hosted (Docker Compose) ──
# Copy this file to `.env` and fill in real values, then: docker compose up -d --build

# PostgreSQL (data lives in the `db_data` Docker volume)
POSTGRES_USER=waw
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=waw

# Which user ids are admins (manage giveaways). Comma-separated. First user is 1.
ADMIN_USER_IDS=1

# Free LLM relevance check for giveaway reviews (optional — leave empty to disable).
# Default provider is OpenRouter; get a key at openrouter.ai/keys.
LLM_API_KEY=

# Transactional email (optional — leave empty to disable verification emails).
BREVO_API_KEY=
BREVO_SENDER=

# Host port the site is served on (http://SERVER_IP:WEB_PORT)
WEB_PORT=3000

# Sub-path the site is served under, e.g. https://makuku.ddns.net/waw-movie
# Baked into the frontend at build time — change it and rebuild (up -d --build).
# Set to an empty value only if you serve the app at the domain root.
NEXT_PUBLIC_BASE_PATH=/waw-movie
